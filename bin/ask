#!/usr/bin/env python3
"""ask — typed decisions from the local Laya daemon. No generation, ~20-150ms.

  ask route <text>                       task type, needs-web, needs-docs, needs-reasoning
  ask relevant <question> <file>...      relevance score per document (0-1, keep >= 0.5)
  ask triage <file>...                   kind, urgency, needs_reply, is_spam per document
  ask yesno <state> <instruction>        single yes/no score
  ask predict <state> <questions-json>   raw /v1/systemone call

Questions come from local-laya/shared.json ($LAYA_SHARED overrides), shared
with the MCP server, the hook gate and the pi extension.
Daemon discovery: $LAYA_URL, else :8124 (gpu) then :8123 (cpu) — only
listeners owned by this user. $LAYA_API_KEY is sent as a bearer token.
Answers go to stdout as JSON; diagnostics to stderr.
"""
import json, os, sys, urllib.request, urllib.error

S = json.load(open(os.environ.get("LAYA_SHARED")
                   or os.path.expanduser("~/Projects/local-laya/shared.json")))
MAX_FILES = 64  # the daemon's batch limit


def own_listener(port):
    """A default port only counts when this user's process listens on it —
    another local user squatting it must never see our text."""
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            rows = open(table).read().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            f = row.split()
            if len(f) > 7 and f[3] == "0A" and int(f[1].rsplit(":", 1)[1], 16) == port \
                    and int(f[7]) == os.getuid():
                return True
    return False


def urls():
    if os.environ.get("LAYA_URL"):
        return [os.environ["LAYA_URL"]]
    return [f"http://127.0.0.1:{p}" for p in (8124, 8123) if own_listener(p)]


def post(path, body):
    err = "no laya daemon owned by this user on :8124/:8123 — start one with ~/Projects/local-laya/laya-serve cpu|gpu"
    for u in urls():
        req = urllib.request.Request(
            u + path, data=json.dumps(body).encode(),
            headers={"Content-Type": "application/json",
                     **({"Authorization": "Bearer " + os.environ["LAYA_API_KEY"]}
                        if os.environ.get("LAYA_API_KEY") else {})})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            err = f"{u} returned {e.code}: {e.read().decode()[:200]}"
        except OSError as e:
            err = f"{u}: {e}"
    sys.exit("ask: " + err)


def answers(result, questions):
    """Typed values only: a choice must be a criteria key, a score/noul a number."""
    ans = result.get("answers") if isinstance(result, dict) else None
    ans = ans if isinstance(ans, dict) else {}
    out = {}
    for qid, q in questions.items():
        a = ans.get(qid)
        v = a.get("choice", a.get("score", a.get("noul"))) if isinstance(a, dict) else a
        if isinstance(q, dict) and q.get("type") == "choice":
            out[qid] = v if isinstance(v, str) and v in (q.get("criteria") or {}) else None
        else:
            out[qid] = round(float(v), 4) if isinstance(v, (int, float)) and not isinstance(v, bool) else None
    return out


def read_doc(f):
    """Same state shape as laya-mcp.py so scores match across agents."""
    if f == "-":
        return "file: stdin\n\n" + sys.stdin.read(4000)
    if not os.path.isfile(f):  # a fifo/device could block forever
        raise OSError("not a regular file")
    with open(f, encoding="utf-8", errors="replace") as fh:
        return f"file: {os.path.basename(f)}\n\n" + fh.read(4000)


def score_files(files, questions):
    """One batch call for all files; per-file error entries instead of crashes."""
    items = []
    for f in files[:MAX_FILES]:
        try:
            items.append({"file": f, "state": read_doc(f)})
        except OSError as e:
            items.append({"file": f, "error": str(e)})
    good = [it for it in items if "state" in it]
    res = post("/v1/systemone/batch",
               {"requests": [{"state": it["state"], "questions": questions} for it in good]}) if good else {}
    results = res.get("results") if isinstance(res, dict) else None
    scores = dict(zip((it["file"] for it in good), results if isinstance(results, list) else []))
    return [{"file": it["file"], **answers(scores.get(it["file"]), questions)} if "state" in it else it
            for it in items]


USAGE = """usage: ask <command> ...
  ask route "text"                        route a user request
  ask relevant "question" FILE...         relevance per file
  ask triage FILE...                      kind/urgency/needs_reply/is_spam per file
  ask yesno "state" "instruction"         yes/no score
  ask predict "state" '<questions-json>'  raw call"""


def need(args, n):
    if len(args) < n:
        sys.exit(USAGE)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "route":
        need(sys.argv, 3)
        print(json.dumps(answers(post("/v1/systemone", {"state": sys.argv[2], "questions": S["route"]}), S["route"])))
    elif cmd == "relevant":
        need(sys.argv, 4)
        q = {"relevant": {"type": "noul", "instructions": S["relevant"].format(question=sys.argv[2])}}
        out = score_files(sys.argv[3:], q)
        out.sort(key=lambda x: -(x.get("relevant") or 0))
        print(json.dumps(out))
    elif cmd == "triage":
        need(sys.argv, 3)
        print(json.dumps(score_files(sys.argv[2:], S["triage"])))
    elif cmd == "yesno":
        need(sys.argv, 4)
        q = {"answer": {"type": "noul", "instructions": sys.argv[3]}}
        print(json.dumps(answers(post("/v1/systemone", {"state": sys.argv[2], "questions": q}), q)))
    elif cmd == "predict":
        need(sys.argv, 4)
        print(json.dumps(post("/v1/systemone", {"state": sys.argv[2], "questions": json.loads(sys.argv[3])})))
    else:
        sys.exit(USAGE)


if __name__ == "__main__":
    main()
