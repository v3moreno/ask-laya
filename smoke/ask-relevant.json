import json, urllib.request
URLS = ["http://127.0.0.1:8124", "http://127.0.0.1:8123"]
req = urllib.request.Request("http://127.0.0.1:8124/ask/relevant",
 data=json.dumps({"state": "ask",
 "relevant": {"type": "noul", "instructions": "Does this text contain information that helps answer: what did my ISP say about the charge??"}}).encode(),
 headers={"Content-Type": "application/json"})
resp = urllib.request.urlopen(req, timeout=5)
import json; result = json.loads(resp.read().decode()); print("Result:", result["relevant"])
